HOST=127.0.0.1
PORT=3000
DATA_DIR=./data
CALENDAR_URL=https://cal.com/patientcreations/15min
# Optional HTTPS automation receiver. Set both to enable background delivery.
# Requests include X-Webhook-Signature: sha256=<HMAC-SHA256 of exact JSON body>.
# Configure the receiver to verify the signature and deduplicate by event_id.
AUTOMATION_WEBHOOK_URL=
AUTOMATION_WEBHOOK_SECRET=
# Set to 1 only behind a trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY=0
